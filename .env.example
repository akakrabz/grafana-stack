# Copy these into the Portainer stack "Environment variables" section
# (or into a .env file for plain docker compose). Never commit real values.

# --- InfluxDB ---
INFLUXDB_PORT=8086
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-strong-password
INFLUXDB_ORG=homelab
INFLUXDB_BUCKET=proxmox
INFLUXDB_RETENTION=30d
# generate with:  openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=change-me-64-hex-chars

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
# e.g. http://monitoring.lan:3000/  (leave default if unsure)
GRAFANA_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/

# --- in-stack Telegraf (docker metrics) ---
# GID of the "docker" group inside the LXC:  getent group docker | cut -d: -f3
DOCKER_GID=999

{
  "uid": "pve-hardware",
  "title": "Host Hardware (IPMI / sensors / SMART / disks)",
  "tags": [
    "proxmox",
    "hardware",
    "host"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
